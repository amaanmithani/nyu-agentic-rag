# Copy to .env and fill in. Never commit .env.

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# "anthropic" for real runs, "stub" for CI/smoke tests (no API key needed)
LLM_PROVIDER=anthropic

# --- Embeddings (local, via fastembed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Postgres ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag

# --- Agent safety limits ---
MAX_STEPS=8
TOOL_TIMEOUT_S=5
TOOL_MAX_RETRIES=2
MAX_TOKENS_PER_RUN=60000
RUN_DEADLINE_S=60

# Fault injection for eval case 8, format tool:mode:count  (e.g. search_documents:timeout:1)
FAULT_INJECT=

# --- Images (used for update/rollback) ---
IMAGE_TAG=local
